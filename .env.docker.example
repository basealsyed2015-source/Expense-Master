# Add these lines to your .env when using Docker for local D1 only.
# Docker does not run the app — use: npm run db:docker  then  npm run dev
# npm run dev auto-syncs D1 from v3/ to d1/ (wrangler CLI vs vite use different paths)

WRANGLER_CONFIG_PATH=wrangler.docker.toml
WRANGLER_PERSIST_PATH=.wrangler/docker-state

NODE_ENV=development
APP_URL=http://localhost:5173

# Optional
# RESEND_API_KEY=
# EMAIL_FROM=Tamweel <onboarding@resend.dev>

SESSION_SECRET=local-docker-dev-secret-change-me
