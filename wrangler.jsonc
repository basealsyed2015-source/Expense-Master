{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tamweel-calc",
  "compatibility_date": "2024-12-14",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tamweel-production-v2",
      "database_id": "67526746-97fb-4914-aa8f-d3cc73a6ab87"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "tamweel-attachments-production"
    }
  ]
}
