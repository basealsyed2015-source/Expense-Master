{
  "name": "tamweel-calc",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/sync-d1-persist.mjs && vite",
    "db:sync-persist": "node scripts/sync-d1-persist.mjs",
    "db:import-utf8": "node scripts/import-d1-utf8.mjs",
    "db:clone-remote": "node scripts/clone-remote-d1.mjs",
    "build": "node scripts/build-contracts-ts-pages.mjs && vite build",
    "build:contracts-pages": "node scripts/build-contracts-ts-pages.mjs",
    "preview": "wrangler pages dev dist",
    "db:docker": "docker compose -f docker-compose.local.yml run --rm db",
    "db:docker:reset": "docker compose -f docker-compose.local.yml run --rm -e FORCE_DB_RESET=1 db",
    "deploy:chat-do": "wrangler deploy -c wrangler.chat-do.toml",
    "deploy:cron": "wrangler deploy -c wrangler.cron.toml",
    "deploy": "npm run build && wrangler pages deploy dist --project-name tamweel-calc-prod --branch=\"ZAT  _developer\" --commit-dirty=true",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "hono": "^4.11.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^11.10.0",
    "@hono/vite-build": "^1.8.0",
    "@hono/vite-dev-server": "^0.23.0",
    "nodemon": "^3.0.2",
    "vite": "^7.3.0",
    "wrangler": "^4.56.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
